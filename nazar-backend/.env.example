# memory = offline hackathon demo (default, no DB needed)
# postgis = full pipeline against a real PostGIS database
DATA_BACKEND=memory

# --- only used when DATA_BACKEND=postgis ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nazar
DB_USER=nazar
DB_PASSWORD=nazar

# --- pipeline tuning ---
NDSM_HEIGHT_THRESHOLD_M=2.5
SPATIAL_MATCH_THRESHOLD=0.65
MATCH_WEIGHT_IOU=0.4
MATCH_WEIGHT_CENTROID=0.25
MATCH_WEIGHT_AREA=0.15
MATCH_WEIGHT_ATTRIBUTE=0.20

# --- synthetic dataset (Module F) ---
SYNTHETIC_PARCEL_COUNT=400
SYNTHETIC_ANOMALY_COUNT=40
SYNTHETIC_SEED=42
SYNTHETIC_CENTER_LAT=28.5355
SYNTHETIC_CENTER_LNG=77.3910

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
